# ==========================================
# HEMI ARCADE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# ==========================================

PORT=3000
SERVER_PORT=3001
NODE_ENV=development
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Admin & Settlement Wallets (Hemi Sepolia Testnet)
ADMIN_WALLETS=0xYourAdminWalletAddress
BACKEND_PRIVATE_KEY=0xYourBackendPrivateKey
ADMIN_PRIVATE_KEY=0xYourAdminPrivateKey

# Cloudflare R2 Storage (Profile Pictures & Avatars)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-bucket-public-url.r2.dev

# ==========================================
# 1. HEMI CHESS CONFIGURATION
# ==========================================
HEMI_CHESS_ELO_ADDRESS=0xeE82E97e9B8bA9b189FcB7Dedb65Dc3717f41d79
NEXT_PUBLIC_HEMI_CHESS_ELO_ADDRESS=0xeE82E97e9B8bA9b189FcB7Dedb65Dc3717f41d79

CHESS_SUPABASE_URL=https://your-chess-supabase-project.supabase.co
CHESS_SUPABASE_ANON_KEY=your-chess-anon-key
CHESS_SUPABASE_SERVICE_KEY=your-chess-service-role-key

NEXT_PUBLIC_CHESS_SUPABASE_URL=https://your-chess-supabase-project.supabase.co
NEXT_PUBLIC_CHESS_SUPABASE_ANON_KEY=your-chess-anon-key

# ==========================================
# 2. HEMI CRAZY 8 CONFIGURATION
# ==========================================
CRAZY8_TOKEN_ADDRESS=0x19B111602A60442CCbe947a58a5fd7CB0195324E
NEXT_PUBLIC_CRAZY8_TOKEN_ADDRESS=0x19B111602A60442CCbe947a58a5fd7CB0195324E
CRAZY8_ESCROW_ADDRESS=0xbD42f75Fee8aD5Dd260DAbbC0520b5A0Efa1F060
NEXT_PUBLIC_CRAZY8_ESCROW_ADDRESS=0xbD42f75Fee8aD5Dd260DAbbC0520b5A0Efa1F060

UNO_SUPABASE_URL=https://your-uno-supabase-project.supabase.co
UNO_SUPABASE_SERVICE_ROLE_KEY=your-uno-service-role-key
UNO_SUPABASE_ANON_KEY=your-uno-anon-key

NEXT_PUBLIC_UNO_SUPABASE_URL=https://your-uno-supabase-project.supabase.co
NEXT_PUBLIC_UNO_SUPABASE_ANON_KEY=your-uno-anon-key

# ==========================================
# 3. HEMI CONNECT 4 CONFIGURATION
# ==========================================
HEMI_CONNECT4_ELO_ADDRESS=0xfe6dc2c29b9f0e83c229a9a3deb1c89cde81afa3
