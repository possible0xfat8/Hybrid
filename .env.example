# ============================================================================
# ON-CHAIN ORACLE / ADMIN SIGNER (Only Secret Needed)
# ============================================================================
# Used by the unified backend to settle matches on-chain (Hemi Chess ELO,
# Hemi Connect 4 ELO, Hemi Crazy 8 Escrow) and dispense 10,000 $CRAZY8 airdrops.
# Setting either BACKEND_PRIVATE_KEY or ADMIN_PRIVATE_KEY works for all games.
BACKEND_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=

# Optional comma-separated list of admin wallet addresses for the Chess Admin Panel
ADMIN_WALLETS=

